# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/depin_monitor

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Chain (settlement worker) ---
# RPC + a funded key that is the OWNER of the deployed MonitorRegistry
CHAIN_RPC_URL=http://127.0.0.1:8545
SETTLEMENT_PRIVATE_KEY=
MONITOR_REGISTRY_ADDRESS=
MONITOR_TOKEN_ADDRESS=

# --- Workers ---
ENABLE_SCHEDULER=true
ENABLE_SETTLEMENT_WORKER=true
JOB_SCHEDULER_CRON=*/1 * * * *
SETTLEMENT_CRON=*/2 * * * *
CONSENSUS_MIN_SUBMISSIONS=3

# --- Alerting (Phase 5) ---
# How many consecutive consensus settlements must agree before a status flip alerts
ALERT_CONFIRM_THRESHOLD=2
APP_BASE_URL=http://localhost:3000
ALERT_FROM=DePIN Monitor <alerts@depin.local>
# Option A: Resend (https://resend.com) — set just the API key
RESEND_API_KEY=
# Option B: SMTP (Gmail app password, Mailtrap, etc.) — used if RESEND_API_KEY is blank
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# If neither is set, alerts are printed to the server console (fine for the demo).
