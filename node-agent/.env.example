# --- Identity ---
# Node wallet private key (testnet only!). If blank, `register` generates one and
# saves it to ./node-wallet.json.
PRIVATE_KEY=
WALLET_FILE=./node-wallet.json

# --- Region ---
NODE_REGION=us-east

# --- Backend ---
BACKEND_URL=http://localhost:4000

# --- Chain (for staking + optional on-chain result submission) ---
CHAIN_RPC_URL=http://127.0.0.1:8545
MONITOR_REGISTRY_ADDRESS=
MONITOR_TOKEN_ADDRESS=
SUBMIT_ONCHAIN=false

# --- Behaviour ---
POLL_INTERVAL_SECONDS=15
HEADLESS=true
RENDER_TIMEOUT_MS=20000
DASHBOARD_PORT=5055

# DEMO ONLY: force this node to always report up|down regardless of the real check
# (lets an examiner watch consensus catch a dishonest node). Leave blank normally.
FORCE_STATUS=
